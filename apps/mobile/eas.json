{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://SEU-SERVIDOR.up.railway.app"
      }
    },
    "online": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://SEU-SERVIDOR.up.railway.app"
      }
    }
  }
}
