# Variáveis de ambiente do servidor. Em produção, cadastre-as no painel do provedor (Railway, Render...).
# Nunca coloque senhas reais neste arquivo nem em nenhum arquivo do GitHub. Explicação em docs/PUBLICAR-ONLINE.md.
# Obrigatória em produção. Ex.: postgresql://usuario:senha@host:5432/banco
DATABASE_URL=postgres://postgres:postgres@localhost:5432/runterritory
# true para bancos na nuvem que exigem SSL (Supabase, Neon).
DATABASE_SSL=false
# Conexões abertas com o banco (o plano grátis do Supabase aguenta poucas).
DATABASE_POOL_MAX=10

# production liga as proteções: proxy confiável, mapa público sem posições ao vivo.
NODE_ENV=development
# O provedor (Railway, Render) costuma definir PORT sozinho.
PORT=3000

# Origens web liberadas no CORS, separadas por vírgula. Vazio = todas (o app usa token, não cookie).
CORS_ORIGINS=
# true quando há um proxy na frente (Railway, Render, Fly). Padrão: true em produção.
TRUST_PROXY=
# Limite de tentativas de login/cadastro (10/min por IP) e de chamadas (300/min por IP).
RATE_LIMIT=true
# Mostrar no mapa público (sem login) onde os corredores estão agora. Padrão: false em produção.
PUBLIC_LIVE_RUNNERS=
# Dias sem uso até o login expirar.
SESSION_TTL_DAYS=60
